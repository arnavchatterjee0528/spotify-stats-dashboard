# Server port
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spotify-stats?retryWrites=true&w=majority

# Spotify app credentials (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in your Spotify app settings EXACTLY.
# Spotify does not allow "localhost", so use 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Where to send the browser after login (the React app)
CLIENT_URL=http://127.0.0.1:5173

# Long random string used to sign login cookies
JWT_SECRET=change-me-to-a-long-random-string

# How often the background sync pulls recently played tracks (cron syntax)
SYNC_CRON=*/30 * * * *
